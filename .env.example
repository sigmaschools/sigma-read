# ─── Database ───────────────────────────────────────────────
# Required. Neon Postgres connection string.
DATABASE_URL=

# ─── AI / Search APIs ──────────────────────────────────────
# Required. Anthropic Claude API key (used for conversations and article generation).
ANTHROPIC_API_KEY=

# Required for article generation. Brave Search API key.
BRAVE_API_KEY=

# ─── Email ──────────────────────────────────────────────────
# Required for parent emails. Resend API key.
RESEND_API_KEY=

# Optional. Sender address for emails (defaults to "SigmaRead <noreply@sigmaread.app>").
EMAIL_FROM=

# ─── Auth ───────────────────────────────────────────────────
# REQUIRED. Secret used to sign JWTs (session tokens and auto-login links).
# Production deploys MUST set this — there is no fallback.
JWT_SECRET=

# REQUIRED. Bearer token used to authenticate cron job requests.
# Production deploys MUST set this — there is no fallback.
CRON_SECRET=

# ─── App Config ─────────────────────────────────────────────
# Required for email links. Base URL of the deployed app.
APP_URL=https://your-app.vercel.app
